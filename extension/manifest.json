{
  "manifest_version": 3,
  "name": "AIUB Slide Downloader",
  "version": "12.0",
  "description": "Saves new slides and notes from the AIUB portal and your Teams classes into your AIUB folder, numbered in order. Unofficial.",
  "minimum_chrome_version": "122",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://portal.aiub.edu/*",
    "https://aiubedu60714.sharepoint.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://portal.aiub.edu/Student*"
      ],
      "js": [
        "lib.js",
        "disk.js",
        "panel.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://aiubedu60714.sharepoint.com/sites/msteams_*"
      ],
      "js": [
        "site-learner.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AIUB Slide Downloader - check for new files now",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  }
}
